# kinesiology-app — environment variables (copy to .env, never commit real values)

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (AI features)
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=

# Analytics / conversion tracking (optional — app works without them)
# GA4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Google Ads conversion label, e.g. AW-XXXXXXXXX/YYYYYYYY
VITE_GOOGLE_ADS_CONVERSION_ID=