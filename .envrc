# kinesiology-app — per-project env (auto-loaded by direnv on cd)
dotenv

# OpenRouter — per-project key (migrated out of ~/.zshrc)
export OPENROUTER_API_KEY="${OPENROUTER_API_KEY:?missing OPENROUTER_API_KEY in .env}"

# Supabase — project xebtjnvfkroiplyzftas
export SUPABASE_URL="${SUPABASE_URL:?missing SUPABASE_URL in .env}"
export SUPABASE_PUBLISHABLE_KEY="${SUPABASE_PUBLISHABLE_KEY:?missing SUPABASE_PUBLISHABLE_KEY in .env}"
export SUPABASE_SERVICE_ROLE_KEY="${SUPABASE_SERVICE_ROLE_KEY:?missing SUPABASE_SERVICE_ROLE_KEY in .env}"

# Optional per-project overrides (comment out if not needed)
# export OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"
