// @ts-nocheck
import { serve } from "https://deno.land/std@0.168.0/http/server.ts"

const corsHeaders = {
  'Access-Control-Allow-Origin': '*',
  'Access-Control-Allow-Headers': 'authorization, x-client-info, apikey, content-type, x-supabase-client-platform',
  'Access-Control-Allow-Methods': 'POST, OPTIONS',
}

serve(async (req) => {
  if (req.method === 'OPTIONS') return new Response('ok', { headers: corsHeaders })

  console.log("--- [manage-calcom-availability] v4.8 — Cal.com v2 FULL DAY BLOCK — DEPLOY TEST ---");

  try {
    const { action, date, scheduleId: providedScheduleId } = await req.json()
    const CALCOM_KEY = Deno.env.get('CALCOM_API_KEY')

    if (!CALCOM_KEY?.startsWith('cal_')) {
      throw new Error("Invalid CALCOM_API_KEY - must start with cal_ or cal_live_");
    }

    const targetId = providedScheduleId || "1387833";
    const dateOnly = new Date(date).toISOString().split('T')[0];

    console.log(`Action: ${action}, Target Date: ${dateOnly}, ScheduleID: ${targetId}`);

    // Fetch current (v2)
    console.log("FETCHING CURRENT SCHEDULE (v2)...");
    const getRes = await fetch(`https://api.cal.com/v2/schedules/${targetId}`, {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${CALCOM_KEY}`,
        'cal-api-version': '2024-08-13',
        'Content-Type': 'application/json'
      }
    });

    const getData = await getRes.json();
    if (!getRes.ok) throw new Error(`Fetch failed: ${getData.message || getRes.statusText}`);

    let currentOverrides = getData.data?.overrides || [];
    console.log(`CURRENT OVERRIDES COUNT: ${currentOverrides.length}`);

    const updatedOverrides = currentOverrides.filter((o: any) => {
      const oDate = typeof o.date === 'string' ? o.date.split('T')[0] : String(o.date || '');
      return oDate !== dateOnly;
    });

    if (action === 'block-day') {
      console.log(`Adding FULL-DAY BLOCK for ${dateOnly}`);

      updatedOverrides.push({
        date: dateOnly,
        startTime: "00:00",
        endTime: "00:00"   // This is the pattern that most reliably blocks the full day via overrides
      });
    }

    const payload = { overrides: updatedOverrides };

    console.log("SENDING v2 PATCH PAYLOAD:", JSON.stringify(payload));

    const patchRes = await fetch(`https://api.cal.com/v2/schedules/${targetId}`, {
      method: 'PATCH',
      headers: {
        'Authorization': `Bearer ${CALCOM_KEY}`,
        'cal-api-version': '2024-08-13',
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    });

    const patchData = await patchRes.json();
    console.log(`PATCH Status: ${patchRes.status}`);
    console.log("FULL PATCH RESPONSE BODY:", JSON.stringify(patchData, null, 2));

    if (!patchRes.ok) {
      throw new Error(`PATCH failed: ${patchData.message || patchRes.statusText}`);
    }

    const finalOverrides = patchData.data?.overrides || [];
    console.log("FINAL OVERRIDES COUNT:", finalOverrides.length);

    const isBlocked = finalOverrides.some((o: any) => {
      const oDate = typeof o.date === 'string' ? o.date.split('T')[0] : String(o.date || '');
      return oDate === dateOnly;
    });

    return new Response(JSON.stringify({ 
      success: true,
      action,
      date: dateOnly,
      overridesCount: finalOverrides.length,
      actuallyBlocked: isBlocked
    }), { 
      status: 200, 
      headers: { ...corsHeaders, 'Content-Type': 'application/json' } 
    });

  } catch (error) {
    console.error("CRITICAL ERROR:", error.message);
    return new Response(JSON.stringify({ 
      status: 'error', 
      message: error.message 
    }), { 
      status: 400, 
      headers: { ...corsHeaders, 'Content-Type': 'application/json' } 
    });
  }
})